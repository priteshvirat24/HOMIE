# Environment Variables
# Copy this file to .env and fill in the values

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homie
POSTGRES_USER=homie
POSTGRES_PASSWORD=homie_dev_password

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === MinIO / S3 ===
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_IMAGES=homie-images
S3_BUCKET_SCENES=homie-scenes
S3_REGION=us-east-1

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key-in-production
API_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# === JWT ===
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Reconstruction APIs ===
WORLD_LABS_API_KEY=your_world_labs_key_here
FAL_KEY=your_fal_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# === Vision AI (for scene analysis) ===
# Use one of: openai, google, anthropic
VISION_AI_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Mobile App ===
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WS_URL=ws://localhost:8000
